# Copy to .env (never commit .env). These are SERVER-SIDE ONLY: no VITE_ prefix,
# so Vite never bundles them into the browser. Read by api/flight.js
# (Vercel serverless function, and the local dev middleware in vite.config.js).
FLIGHTAWARE_API_KEY=
AERODATABOX_RAPIDAPI_KEY=
AVIATIONSTACK_API_KEY=
